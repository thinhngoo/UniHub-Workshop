PORT=
DATABASE_URL=
JWT_SECRET=
REDIS_URL=

# Rate limiting (@nestjs/throttler): max requests per IP per TTL window (in-memory storage).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Behind a reverse proxy: set to 1 so throttling uses X-Forwarded-For for the client IP.
TRUST_PROXY=

# Email (optional). If SMTP_HOST is empty, Mailer uses jsonTransport (no real delivery; useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Mock payment gateway (redirect + webhook). When USE_MOCK_PAYMENT_GATEWAY is unset/false, POST /payments completes payment synchronously (dev shortcut).
USE_MOCK_PAYMENT_GATEWAY=
# Base URL of this API as reachable by browser & server (e.g. http://localhost:3000). Required when USE_MOCK_PAYMENT_GATEWAY=true.
PUBLIC_APP_URL=
# Shared secret for HMAC-SHA256 hex digest header x-mock-payment-signature on POST /payments/webhooks/mock-gateway.
MOCK_PAYMENT_WEBHOOK_SECRET=

# Comma-separated URL prefixes allowed for POST /payments body returnUrl (anti open-redirect). E.g. http://localhost:5173
PAYMENT_RETURN_URL_ALLOWLIST=

# Payment gateway circuit breaker (Redis key payment_gateway:circuit:v1). Opt-in: set PAYMENT_GATEWAY_CB_ENABLED=true.
PAYMENT_GATEWAY_CB_ENABLED=
PAYMENT_GATEWAY_CB_FAILURE_THRESHOLD=
PAYMENT_GATEWAY_CB_RESET_MS=
# When circuit open / probe fails: true (default if unset) → HTTP 200 + degraded payload; false → HTTP 503.
PAYMENT_GATEWAY_CB_GRACEFUL_RESPONSE=
PAYMENT_GATEWAY_CB_USER_MESSAGE=
# Optional outbound GET — failures count toward circuit (5xx / 429 / timeout).
PAYMENT_GATEWAY_HEALTHCHECK_URL=
PAYMENT_GATEWAY_HEALTHCHECK_TIMEOUT_MS=
PAYMENT_GATEWAY_PROBE_RETRY_AFTER_SEC=

# POST /payments Idempotency-Key replay window (Redis). TTL capped by reservation expiry when set.
PAYMENT_INIT_IDEMPOTENCY_TTL_SECONDS=
