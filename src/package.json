{
  "name": "unihub-workshop",
  "version": "0.0.0",
  "private": true,
  "description": "UniHub Workshop monorepo",
  "scripts": {
    "install:all": "pnpm install",
    "prisma:generate": "pnpm --filter @unihub/api run prisma:generate",
    "setup": "pnpm install && pnpm run prisma:generate",
    "dev:sv": "pnpm --filter @unihub/web-sv dev",
    "dev:admin": "pnpm --filter @unihub/web-admin dev",
    "dev:api": "pnpm --filter @unihub/api start:dev",
    "dev:checkin": "pnpm --filter @unihub/mobile-checkin start",
    "typecheck": "pnpm -r typecheck",
    "lint:api": "pnpm --filter @unihub/api lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
